{
  "name": "sqp-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "landing:dev": "pnpm -F @sqp/landing dev",
    "landing:build": "pnpm -F @sqp/landing build",
    "landing:deploy:staging": "pnpm -F @sqp/landing deploy:staging",
    "landing:deploy": "pnpm -F @sqp/landing deploy:production",
    "ingest:dev": "pnpm -F @sqp/ingest dev",
    "ingest:deploy": "pnpm -F @sqp/ingest run deploy",
    "dashboard:dev": "pnpm -F @sqp/dashboard dev",
    "dashboard:build": "pnpm -F @sqp/dashboard build",
    "dashboard:deploy": "pnpm -F @sqp/dashboard run deploy",
    "shared:test": "pnpm -F @sqp/shared test",
    "format": "prettier -w .",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
