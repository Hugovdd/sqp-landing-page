{
  // Admin telemetry dashboard (Next.js via @opennextjs/cloudflare).
  // Owns dashboard.sidequestplugins.com; auth is enforced by Cloudflare Access
  // in front of the hostname (no in-app auth). Reads the shared D1 store.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sqp-admin-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "routes": [{ "pattern": "dashboard.sidequestplugins.com", "custom_domain": true }],

  // Same D1 as ingest, read-only usage. database_id is a placeholder for local
  // dev; replace with the real id from `wrangler d1 create sqp-telemetry`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sqp-telemetry",
      "database_id": "3d27d61b-11db-4b17-bc84-5edc8ede07d1"
    }
  ]
}
