---
import { getCollection } from "astro:content";

import { BlogList } from "@/components/blocks/blog-list";
import type { Article } from "@/components/marketing/blog/base-components/blog-cards";
import StructuredData from "@/components/StructuredData.astro";
import { SITE } from "@/consts";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { buildBreadcrumbSchema } from "@/lib/seo";

const isDev = import.meta.env.DEV;

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => isDev || !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const articles: Article[] = posts.map((post) => ({
  id: post.id,
  href: `/blog/${post.id}`,
  thumbnailUrl: post.data.heroImage,
  title: post.data.title,
  summary: post.data.summary,
  category: {
    name: post.data.category.name,
    href: `/blog/category/${post.data.category.slug}`,
  },
  author: {
    name: post.data.author.name,
    href: post.data.author.href ?? "#",
    avatarUrl: post.data.author.avatarUrl ?? "",
  },
  publishedAt: post.data.publishedAt.toLocaleDateString("en-US", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }),
  readingTime: (() => {
    const wpm = 200;
    const words = (post.body ?? "").split(/\s+/).length;
    return `${Math.max(1, Math.ceil(words / wpm))} min read`;
  })(),
  tags: post.data.tags.map((tag) => ({
    name: tag.name,
    color: tag.color,
    href: `/blog/tag/${tag.slug}`,
  })),
  isFeatured: post.data.isFeatured,
}));

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: SITE.domain },
  { name: "Blog", url: `${SITE.domain}/blog` },
]);
---

<DefaultLayout
  title={`Blog — After Effects Tips & Tutorials | ${SITE.name}`}
  description="After Effects tutorials, workflow tips, and motion design guides from the team at Sidequest Plugins. Learn how to automate and speed up your AE workflow."
  keywords="After Effects tutorials, AE workflow tips, motion design guides, After Effects scripts tutorial, AE localization, font management After Effects"
>
  <StructuredData slot="head" data={breadcrumbSchema} />

  <BlogList
    articles={articles}
    heading="Resources and insights"
    subheading="Our blog"
    description="After Effects tutorials, workflow tips, and motion design guides to help you work faster and smarter."
    client:load
  />
</DefaultLayout>
