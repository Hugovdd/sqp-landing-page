---
import { getCollection } from "astro:content";

import { BlogList } from "@/components/blocks/blog-list";
import StructuredData from "@/components/StructuredData.astro";
import { SITE } from "@/consts";
import DefaultLayout from "@/layouts/DefaultLayout.astro";
import { buildBreadcrumbSchema } from "@/lib/seo";
import type { Article } from "@/components/marketing/blog/base-components/blog-cards";

export async function getStaticPaths() {
  const isDev = import.meta.env.DEV;
  const allPosts = await getCollection("blog");
  const posts = allPosts.filter((p) => isDev || !p.data.draft);

  const tags = new Map<string, { name: string; slug: string }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      if (!tags.has(tag.slug)) tags.set(tag.slug, { name: tag.name, slug: tag.slug });
    }
  }

  return Array.from(tags.values()).map(({ name, slug }) => ({
    params: { slug },
    props: { tagName: name, tagSlug: slug },
  }));
}

const { tagName, tagSlug } = Astro.props;
const isDev = import.meta.env.DEV;

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter(
    (p) =>
      (isDev || !p.data.draft) &&
      p.data.tags.some((t) => t.slug === tagSlug),
  )
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const articles: Article[] = posts.map((post) => ({
  id: post.id,
  href: `/blog/${post.id}`,
  thumbnailUrl: post.data.heroImage,
  title: post.data.title,
  summary: post.data.summary,
  category: {
    name: post.data.category.name,
    href: `/blog/category/${post.data.category.slug}`,
  },
  author: {
    name: post.data.author.name,
    href: post.data.author.href ?? "#",
    avatarUrl: post.data.author.avatarUrl ?? "",
  },
  publishedAt: post.data.publishedAt.toLocaleDateString("en-US", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }),
  readingTime: (() => {
    const wpm = 200;
    const words = (post.body ?? "").split(/\s+/).length;
    return `${Math.max(1, Math.ceil(words / wpm))} min read`;
  })(),
  tags: post.data.tags.map((tag) => ({
    name: tag.name,
    color: tag.color,
    href: `/blog/tag/${tag.slug}`,
  })),
  isFeatured: post.data.isFeatured,
}));

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: "Home", url: SITE.domain },
  { name: "Blog", url: `${SITE.domain}/blog` },
  { name: tagName, url: `${SITE.domain}/blog/tag/${tagSlug}` },
]);
---

<DefaultLayout
  title={`#${tagName} — ${SITE.name} Blog`}
  description={`Browse all posts tagged "${tagName}" on the Sidequest Plugins blog.`}
>
  <StructuredData slot="head" data={breadcrumbSchema} />

  <BlogList
    articles={articles}
    heading={tagName}
    subheading="Tag"
    description={`All posts tagged "${tagName}".`}
    client:load
  />
</DefaultLayout>
